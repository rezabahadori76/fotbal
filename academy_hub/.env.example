# PostgreSQL (Neon, Vercel Postgres, or local Docker — see docker-compose.yml)
# Local Docker: docker compose up -d && npm run db:setup
DATABASE_URL="postgresql://academy:academy@localhost:5432/academy_hub"
# Optional but recommended for deploy/build tools when using pooled Postgres URLs
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth — required in production (Vercel: add in Project → Settings → Environment Variables)
# Use PitchIQ Flask URL when Academy Hub runs behind /hub proxy (recommended)
NEXTAUTH_URL="http://127.0.0.1:5050/hub"
# Standalone Next dev only: NEXTAUTH_URL="http://localhost:3000/hub"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# One-time production seed via browser (optional): /api/setup/seed?secret=...
SETUP_SECRET="generate-another-random-string"

# Vercel production example (use Postgres, not SQLite):
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."  # direct / non-pooling URL if your provider exposes one
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="<paste output of: openssl rand -base64 32>"
