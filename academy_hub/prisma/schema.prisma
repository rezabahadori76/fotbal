generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COACH
  PLAYER
}

enum QuestionType {
  PREDEFINED
  CUSTOM
}

enum AssignmentStatus {
  PENDING
  ANSWERED
}

enum InjuryStatus {
  ACTIVE
  RECOVERING
  RESOLVED
}

enum InjuryMechanism {
  CONTACT
  NON_CONTACT
}

enum AttendanceStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

enum SessionType {
  TRAINING
  MATCH
  RECOVERY
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coachedPlayers PlayerProfile[] @relation("CoachPlayers")

  playerProfile PlayerProfile? @relation("PlayerUser")

  customQuestions QuestionTemplate[] @relation("QuestionAuthor")

  assignmentsSent QuestionAssignment[] @relation("AssignmentCoach")
  teamEvents TeamEvent[]
  announcements Announcement[] @relation("AnnouncementAuthor")
  developmentGoals DevelopmentGoal[] @relation("GoalCoach")
  announcementReads AnnouncementRead[]
}

model PlayerProfile {
  id        String   @id @default(cuid())
  position  String?
  squad     String?
  jerseyNo  Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation("PlayerUser", fields: [userId], references: [id], onDelete: Cascade)

  coachId String
  coach   User   @relation("CoachPlayers", fields: [coachId], references: [id], onDelete: Cascade)

  assignments QuestionAssignment[]
  wellnessReports WellnessReport[]
  injuryReports InjuryReport[]
  eventAttendances EventAttendance[]
  trainingLoadReports TrainingLoadReport[]
  developmentGoals DevelopmentGoal[] @relation("GoalPlayer")
}

model QuestionTemplate {
  id        String       @id @default(cuid())
  text      String
  category  String?
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  type      QuestionType @default(PREDEFINED)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  authorId String?
  author   User?   @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  assignments QuestionAssignment[]
}

model QuestionAssignment {
  id        String           @id @default(cuid())
  status    AssignmentStatus @default(PENDING)
  dueDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  coachId String
  coach   User   @relation("AssignmentCoach", fields: [coachId], references: [id], onDelete: Cascade)

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  questionId String
  question   QuestionTemplate @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answer Answer?

  @@index([playerId, status])
  @@index([coachId])
}

model Answer {
  id              String   @id @default(cuid())
  selectedOption  Int
  text            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignmentId String             @unique
  assignment   QuestionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model WellnessReport {
  id        String   @id @default(cuid())
  reportDate DateTime
  mood      Int
  energy    Int
  sleep     Int
  stress    Int
  soreness  Int
  restingHeartRate Int?
  symptom   String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, reportDate])
  @@index([playerId, reportDate])
}

model InjuryReport {
  id        String   @id @default(cuid())
  bodyPart  String
  specificPart String?
  description String?
  status    InjuryStatus @default(ACTIVE)
  mechanism InjuryMechanism @default(CONTACT)
  recurrence Boolean @default(false)
  occurredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@index([occurredAt])
}

model TeamEvent {
  id        String   @id @default(cuid())
  title     String
  eventDate DateTime
  startTime String
  endTime   String
  timezone  String @default("EDT")
  location  String?
  field     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coachId String
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  attendances EventAttendance[]
  trainingLoadReports TrainingLoadReport[]

  @@index([coachId, eventDate])
}

model TrainingLoadReport {
  id              String      @id @default(cuid())
  sessionDate     DateTime
  rpe             Int
  durationMinutes Int
  sessionType     SessionType @default(TRAINING)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  eventId String?
  event   TeamEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([playerId, sessionDate])
  @@index([eventId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  targetSquad String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coachId String
  coach   User @relation("AnnouncementAuthor", fields: [coachId], references: [id], onDelete: Cascade)

  reads AnnouncementRead[]

  @@index([coachId, createdAt])
}

model AnnouncementRead {
  id        String   @id @default(cuid())
  readAt    DateTime @default(now())

  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model DevelopmentGoal {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       GoalStatus @default(NOT_STARTED)
  targetDate   DateTime?
  progressNote String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  playerId String
  player   PlayerProfile @relation("GoalPlayer", fields: [playerId], references: [id], onDelete: Cascade)

  coachId String
  coach   User @relation("GoalCoach", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@index([coachId])
}

model EventAttendance {
  id        String   @id @default(cuid())
  status    AttendanceStatus @default(PENDING)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  eventId String
  event   TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  playerId String
  player   PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([playerId, status])
}
